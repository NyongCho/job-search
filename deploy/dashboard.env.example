# Install the real file at ~/.config/job-dashboard/environment, mode 0600.
# Never put the real login or secret in this example or a portable package.
JOBS_DB=/home/YOUR_USER/job_search/data/jobs.sqlite
DASHBOARD_STATE_DB=/home/YOUR_USER/job_search/data/dashboard/dashboard.sqlite
DASHBOARD_BASE_URL=https://your-device.your-tailnet.ts.net
DASHBOARD_ALLOWED_LOGIN=replace-with-your-tailscale-login
DASHBOARD_SECRET_KEY=replace-with-a-persistent-random-secret-of-at-least-32-characters
DASHBOARD_DEV_MODE=0
